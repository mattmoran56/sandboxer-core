# Every variable `sandboxr` itself reads from the environment.
#
# **Nothing loads this file.** There is no compose file and no dotenv in this
# repository: `sandboxr` reads the environment of the shell it runs in. Copy the
# lines you want into your shell profile, or source the whole thing:
#
#   cp .env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a
#
# Every one of these has a working default except where it says otherwise, so an
# empty environment is a valid one. `sandboxr config` prints what resolved.
#
# The values only this machine can look up — the GitHub token out of the login
# keychain, your commit identity — are not here. `sandboxr init` writes those to
# `$SANDBOXR_HOME/host.env` itself, and a sandbox reads them from there.
#
# A *project's* own credentials do not belong here either. They live in
# `$SANDBOXR_HOME/secrets/<project>.env` and are managed with `sandboxr secrets`.

# --- where this machine keeps its state --------------------------------------
# Absolute paths, no `~`: they are bind-mount sources, and they are mounted at
# the identical path inside a sandbox so that a worktree's recorded path means
# the same thing on both sides.

# Everything sandboxr knows about this machine: config.yaml, secrets, the seed
# cache, logs, certificates, slug tokens, the managed workspace.
# SANDBOXR_HOME=/home/you/.sandboxr

# Where managed project mirrors and their worktrees go. Its own variable rather
# than always under the home, because it is the one part of the tree worth
# putting on a different disk.
# SANDBOXR_WORKSPACE=/home/you/.sandboxr/workspace

# The directory holding `container/` and `packages/` — this checkout. sandboxr
# reads the Dockerfiles and the in-container scripts out of it on every build,
# and finds it by walking up from its own module. Set this if you moved or
# packaged the installation.
# SANDBOXR_INSTALL=/home/you/src/sandboxer-core

# --- the domain and the shared router ----------------------------------------

# Anything under `.localhost` resolves to 127.0.0.1 in every current browser and
# in macOS's own resolver, so there is nothing to install for the default. A
# domain that does not end in `.localhost` is your own DNS problem.
# SANDBOXR_DOMAIN=sbx.localhost

# Where the router publishes. Move these if something else on the machine owns
# 80 or 443; the port travels into every URL sandboxr prints. Same as
# `sandboxr init --http-port` / `--https-port`.
# SANDBOXR_HTTP_PORT=80
# SANDBOXR_HTTPS_PORT=443

# Override only to test a router build.
# SANDBOXR_ROUTER_IMAGE=traefik:v3.6

# --- lifetimes ---------------------------------------------------------------
# How long a sandbox may sit unused before `sandboxr expire` will stop it, in
# hours. This is what a service unit or a cron entry sets. It loses to
# `config.yaml` and to `--ttl` on purpose: it is set once by whoever installed
# the timer and then forgotten, and the file is what somebody edits when they
# want a different answer.
# SANDBOXR_TTL_HOURS=12

# --- images ------------------------------------------------------------------
# Skip building the project's own image layer and run this tag instead. For
# testing an image by hand; nothing sets it in normal use.
# SANDBOXR_IMAGE=

# --- MySQL projects ----------------------------------------------------------
# Only read when a project's `sandboxr.yaml` says `database.driver: mysql`.

# Reading the database being copied *from*: a MySQL container on this machine.
# The defaults are `root` and an empty password, which is nobody's local MySQL —
# a seed that dies on "could not fingerprint … — are the source credentials
# right?" is these two lines.
# SANDBOXR_SOURCE_DB_USER=root
# SANDBOXR_SOURCE_DB_PASSWORD=

# The database made *inside* a sandbox, and what the project connects to it as.
# The default database name is the project name folded into a legal identifier.
# SANDBOXR_DB_USER=sandboxr
# SANDBOXR_DB_PASSWORD=sandboxr
# SANDBOXR_DB_ROOT_PASSWORD=sandboxr
# SANDBOXR_DB_NAME=

# Which MySQL a dump is restored into. The default is the version the project
# declares in its config, because a migration is only meaningfully tested
# against the version it will really run on.
# SANDBOXR_MYSQL_IMAGE=

# How long a cached dump stands before it is taken again, in hours.
# SANDBOXR_CACHE_TTL_HOURS=24
