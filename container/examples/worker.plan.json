{
  "project": "edge-thing",
  "database": {
    "driver": "d1",
    "owner": "app",
    "fixtures": "seeds/fixtures.sql",
    "seed": { "path": "/sandboxer/cache/edge-thing-state", "anonymised": true },
    "migrate": {
      "command": "npx wrangler d1 migrations apply DB --local --persist-to $SANDBOXER_D1_DIR"
    }
  },
  "storage": { "driver": "none" },
  "toolchain": { "node": "24" },
  "deps": {
    "root": ".",
    "lockfile": "package-lock.json",
    "install": "npm ci --no-audit --no-fund"
  },
  "services": [
    {
      "kind": "server",
      "label": "app",
      "package": ".",
      "root": ".",
      "serve": "npx wrangler dev --port 8787 --ip 127.0.0.1 --persist-to $SANDBOXER_D1_DIR",
      "port": 8787,
      "health": "/health"
    }
  ],
  "routes": {},
  "env": {
    "API_TOKEN": "dummy",
    "APP_URL": "${SANDBOXER_URL_APP}"
  }
}
