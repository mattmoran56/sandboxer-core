node_modules/
dist/
*.tsbuildinfo
.DS_Store
*.log

# Local state — never committed. See docs/architecture/contracts.md.
.sandboxr/
secrets/*.env
!secrets/.gitkeep

# The compose deployment's settings: this machine's paths, its dashboard password
# and its database credentials. `.env.example` is the committed half of the pair.
/.env

# Wrangler's dev-server scratch, in any example that really runs.
.wrangler/

# Worktrees a Claude Code agent cuts for itself. Each is its own checkout, and
# committing one embeds a repository inside this one.
.claude/worktrees/
__pycache__/
.venv/

# Piper voices are downloaded, not committed: ~60MB each, and which voice you
# want is a preference. See docs/guides/orchestrator.md.
sidecars/models/
