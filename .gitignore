node_modules/
dist/
*.tsbuildinfo
.DS_Store
*.log

# Local state — never committed. See docs/architecture/contracts.md.
.sandboxer/
secrets/*.env
!secrets/.gitkeep

# A shell environment sourced by hand. Nothing in this repository reads it;
# `.env.example` is the committed half of the pair and explains what it is for.
/.env

# Wrangler's dev-server scratch, in any example that really runs.
.wrangler/

# Worktrees a Claude Code agent cuts for itself. Each is its own checkout, and
# committing one embeds a repository inside this one.
.claude/worktrees/
