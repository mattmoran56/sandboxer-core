{
  "name": "@sandboxer/docs",
  "version": "0.1.0",
  "private": true,
  "description": "The sandboxer documentation site: React, TypeScript and Tailwind, built by Vite into static HTML.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node build/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sandboxer/tokens": "0.1.0",
    "marked": "^16.4.2",
    "mermaid": "^11.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
