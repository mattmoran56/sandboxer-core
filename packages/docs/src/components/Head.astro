---
/**
 * Starlight's `<head>`, plus the client-side diagram renderer.
 *
 * Diagrams are written as mermaid code fences so that GitHub renders them when
 * somebody reads the Markdown directly. A remark plugin turns each fence into a
 * placeholder, and this script fills it in — client-side, so a diagram can
 * follow the reader's light or dark theme, which a build-time render cannot.
 */
import Default from "@astrojs/starlight/components/Head.astro";
---

<Default {...Astro.props}><slot /></Default>

<script>
  import mermaid from "mermaid";

  let pass = 0;

  const render = async () => {
    const nodes = document.querySelectorAll<HTMLElement>(".mermaid-diagram");
    if (nodes.length === 0) return;

    const dark = document.documentElement.dataset.theme !== "light";
    mermaid.initialize({
      startOnLoad: false,
      theme: dark ? "dark" : "neutral",
      securityLevel: "strict",
      flowchart: { useMaxWidth: true, curve: "basis" },
      themeVariables: { fontSize: "15px" },
    });

    pass += 1;
    for (const [index, node] of [...nodes].entries()) {
      const chart = node.dataset.chart;
      if (!chart) continue;
      try {
        const { svg } = await mermaid.render(`sbx-diagram-${pass}-${index}`, chart);
        node.innerHTML = svg;
      } catch {
        // Leave the source visible rather than an empty box: a diagram that will
        // not parse is still readable as text, and the failure is then obvious.
      }
    }
  };

  void render();

  new MutationObserver(() => void render()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
